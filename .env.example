# SmartCord local secrets / machine config.
# Copy to `.env` (gitignored) and fill in. Real environment variables override these.
# Format: SMARTCORD_<Section>__<Key>=value  (double underscore = nested config)

# Discord application client id (public-ish, but keep machine config together here)
#SMARTCORD_Discord__ClientId=

# --- Tier 2, not wired yet ---
# WakaTime / Wakapi / Hackatime. The API key itself is stored encrypted via DPAPI
# after first-run "Connect WakaTime…", NOT here. Only the base URL lives in config.
#SMARTCORD_WakaTime__BaseUrl=https://wakatime.com/api/v1

# Spotify uses OAuth 2.0 Authorization Code + PKCE (no client secret on desktop).
# Only the client id is needed; the refresh token is stored encrypted via DPAPI.
#SMARTCORD_Spotify__ClientId=

# Bearer token the agent sends to the deltavdevs backend on POST /api/status/ingest
#SMARTCORD_Status__IngestToken=
